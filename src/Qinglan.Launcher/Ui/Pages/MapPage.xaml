<UserControl x:Class="Qinglan.Launcher.Ui.Pages.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MTR 地图" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,0"
                           Text="内嵌轻蓝服务器上的 MTR 线网地图（WebView2）；运行时缺失时提示不可用并给出浏览器入口。"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnReload" Content="重新加载" Style="{StaticResource BtnGhost}"
                        Margin="0,0,8,0" Click="OnReload"
                        AutomationProperties.AutomationId="BtnReloadMap"/>
                <Button x:Name="BtnOpen" Content="在浏览器打开" Style="{StaticResource BtnPrimary}"
                        Click="OnOpenExternal"
                        AutomationProperties.AutomationId="BtnOpenMap"/>
            </StackPanel>
        </Grid>

        <!-- 地图容器 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0"
                ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>

                <!-- 加载中：WebView2 是独立 HWND，WPF 覆盖层在它上面不可见，所以加载时先隐藏 WebView。 -->
                <Border x:Name="LoadingPanel" Background="#F7FAFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在加载 MTR 地图…" FontSize="15" FontWeight="Bold"
                                   Style="{StaticResource BaseText}" HorizontalAlignment="Center"
                                   AutomationProperties.AutomationId="MapLoadingText"/>
                        <TextBlock x:Name="LoadingDetail" Text="首次打开会初始化 WebView2 用户目录。"
                                   Style="{StaticResource PageHint}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- webview 不可用 / 导航失败 -->
                <Border x:Name="FallbackPanel" Background="#F7FAFF" Visibility="Collapsed">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="FallbackTitle" Text="webview 不可用" FontSize="17"
                                   FontWeight="Bold" Style="{StaticResource BaseText}"
                                   HorizontalAlignment="Center"
                                   AutomationProperties.AutomationId="MapFallbackTitle"/>
                        <TextBlock x:Name="FallbackDetail" Style="{StaticResource PageHint}"
                                   Margin="0,8,0,0" TextAlignment="Center"
                                   AutomationProperties.AutomationId="MapFallbackDetail"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="在浏览器打开地图" Style="{StaticResource BtnPrimary}"
                                    Click="OnOpenExternal"/>
                            <Button Content="重试" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Click="OnReload"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
