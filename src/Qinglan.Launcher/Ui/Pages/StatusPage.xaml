<UserControl x:Class="Qinglan.Launcher.Ui.Pages.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="服务器状态" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="轻蓝服务器 / MTR Web / Reporter 探测（M3 交付）。"
                           Style="{StaticResource PageHint}" Margin="0,4,0,16"/>
                <Border Background="White" BorderBrush="#4F97F0" BorderThickness="1" CornerRadius="10"
                        Padding="16,10">
                    <TextBlock Text="M3 建设中：SLP varint 握手 + HTTP 探测 + 30s 自动轮询。"
                               FontSize="13" Foreground="#33608A" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
