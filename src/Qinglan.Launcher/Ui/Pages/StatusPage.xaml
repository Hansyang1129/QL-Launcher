<UserControl x:Class="Qinglan.Launcher.Ui.Pages.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="服务器状态" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,16"
                       Text="实时探测轻蓝服务器、MTR Web 与 Reporter：可达性、延迟、在线人数与 MOTD。"/>

            <!-- 刷新控制 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RefreshStatusText" Text="尚未探测" FontSize="14"
                                   FontWeight="Bold" FontFamily="Microsoft YaHei UI"
                                   Foreground="{StaticResource TextPrimary}"
                                   AutomationProperties.AutomationId="RefreshStatusText"/>
                        <TextBlock x:Name="SummaryText" Text="" Style="{StaticResource PageHint}"
                                   Margin="0,4,0,0" AutomationProperties.AutomationId="SummaryText"/>
                        <TextBlock Text="停留本页时每 30 秒自动刷新；离开页面即暂停。"
                                   Style="{StaticResource PageHint}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnRefresh" Grid.Column="1" Content="刷新" Style="{StaticResource BtnPrimary}"
                            Padding="22,9" VerticalAlignment="Center" Click="OnRefresh"
                            AutomationProperties.AutomationId="BtnRefresh"/>
                </Grid>
            </Border>

            <!-- 端点卡片由代码填充 -->
            <StackPanel x:Name="ServerList"/>

            <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="SLP 走 Minecraft 1.7+ 状态查询（协议 47），HTTP 仅 200 视为在线；单个端点故障不会影响其他端点。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
