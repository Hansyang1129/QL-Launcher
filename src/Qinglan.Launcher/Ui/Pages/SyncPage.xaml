<UserControl x:Class="Qinglan.Launcher.Ui.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="轻蓝同步" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,16"
                       Text="包驱动的增量同步：更新源就是整合包自己的 .mrpack（现场挑文件，或实例内 .ql-pack 缓存），不再有 manifest 服务器。"/>

            <!-- ======== 实例卡片 ======== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstanceTitle" Text="未选择游戏根目录" FontWeight="Bold" FontSize="15"
                                   FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}"/>
                        <Button Grid.Column="1" Content="选择游戏根目录…" Style="{StaticResource BtnGhost}" Click="OnPickGameDir"/>
                    </Grid>
                    <TextBlock x:Name="InstanceDetail" Style="{StaticResource PageHint}" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="先指定游戏根目录（.minecraft），启动器只管理其中的 Qinglan-2nd-RPU 实例（版本隔离）。"/>
                </StackPanel>
            </Border>

            <!-- ======== 整合包更新卡片 ======== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="整合包更新" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>

                    <TextBlock Style="{StaticResource PageHint}" Margin="0,10,0,6" TextWrapping="Wrap"
                               Text="选整合包文件（.mrpack）作为更新源；实例内的 .ql-pack 缓存里最新的包也可以直接用。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PackPathBox" Style="{StaticResource InputBorder}" IsReadOnly="True"/>
                        <Button x:Name="BtnPackBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" Click="OnPickPack"/>
                    </Grid>
                    <TextBlock x:Name="PackInfoLabel" Style="{StaticResource PageHint}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text=""/>

                    <TextBlock x:Name="OptionalTitle" Text="可选 mod 组" Style="{StaticResource PageHint}" Margin="0,12,0,4"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="OptionalHost"/>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="BtnCheck" Content="查更新" Style="{StaticResource BtnPrimary}"
                                MinWidth="110" Click="OnCheckUpdate"/>
                        <Button x:Name="BtnApply" Content="应用同步" Style="{StaticResource BtnPrimary}"
                                MinWidth="110" Margin="10,0,0,0" IsEnabled="False" Click="OnApply"/>
                    </WrapPanel>

                    <ProgressBar x:Name="SyncBar" Height="6" Minimum="0" Maximum="100" Margin="0,14,0,0"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="SyncResult" Style="{StaticResource PageHint}" Foreground="{StaticResource TextPrimary}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Border>

            <!-- ======== RPU 卡片（闭源组件 · 仅接口挂点） ======== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RPU 资源包" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,6" TextWrapping="Wrap"
                               Text="游戏内 RPU 客户端为闭源组件：resourcepacks 的读写与更新都由它自行完成。启动器只保留三个接口挂点：更新触发、进度展示、日志展示。"/>
                    <ProgressBar x:Name="RpuProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                 Visibility="Collapsed"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RpuStatusText" Style="{StaticResource PageHint}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="（RPU 客户端未接入：更新状态 · 进度 · 日志）"/>
                        <Button x:Name="BtnRpuUpdate" Grid.Column="1" Content="检查 RPU 更新"
                                Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                ToolTip="接口预留：闭源 RPU 客户端接入后由订阅方接管" Click="OnRpuUpdateClick"/>
                    </Grid>
                    <TextBlock x:Name="RpuLogText" Style="{StaticResource PageHint}" Margin="0,8,0,0"
                               FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                               Text="（RPU 日志将显示在这里）"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
