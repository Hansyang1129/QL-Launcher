<UserControl x:Class="Qinglan.Launcher.Ui.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="轻蓝同步" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="manifest 驱动的增量同步：官方包 / 优化包双频道 + 可选 mod 组（M1 交付）。"
                           Style="{StaticResource PageHint}" Margin="0,4,0,16"/>
                <Border Background="White" BorderBrush="#4F97F0" BorderThickness="1" CornerRadius="10"
                        Padding="16,10">
                    <TextBlock Text="M1 建设中：同步引擎已按 QL-HMCL 行为备忘 §7 行为备忘复刻，UI 由测试串起来后接入。"
                               FontSize="13" Foreground="#33608A" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
