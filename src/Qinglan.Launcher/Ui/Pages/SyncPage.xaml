<UserControl x:Class="Qinglan.Launcher.Ui.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="轻蓝同步" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,16"
                       Text="manifest 驱动的增量同步：官方包 / 优化包双频道、可选 mod 组、种子包一键入坑。"/>

            <!-- ======== 实例卡片 ======== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstanceTitle" Text="未选择游戏目录" FontWeight="Bold" FontSize="15"
                                   FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}"/>
                        <Button Grid.Column="1" Content="选择目录…" Style="{StaticResource BtnGhost}" Click="OnPickGameDir"/>
                    </Grid>
                    <TextBlock x:Name="InstanceDetail" Style="{StaticResource PageHint}" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="先指定 QL2 实例目录（含 mods/ 的那个文件夹），再开始同步。"/>
                </StackPanel>
            </Border>

            <!-- ======== 同步卡片 ======== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="同步设置" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>

                    <TextBlock Text="manifest 地址（默认用资源服务器；群文件兜底时可手动换）"
                               Style="{StaticResource PageHint}" Margin="0,10,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManifestUrlBox" Style="{StaticResource InputBorder}"/>
                        <Button x:Name="BtnDefaultUrl" Grid.Column="1" Content="默认" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" Click="OnResetUrl"/>
                    </Grid>

                    <TextBlock Text="频道" Style="{StaticResource PageHint}" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ChannelStd" Content="官方包（std）" GroupName="qlchan" IsChecked="True"
                                     FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="ChannelPfm" Content="优化包（pfm）" GroupName="qlchan" Margin="18,0,0,0"
                                     FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="OptionalTitle" Text="可选 mod 组" Style="{StaticResource PageHint}" Margin="0,12,0,4"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="OptionalHost"/>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="BtnCheck" Content="查更新" Style="{StaticResource BtnPrimary}"
                                MinWidth="110" Click="OnCheckUpdate"/>
                        <Button x:Name="BtnApply" Content="应用同步" Style="{StaticResource BtnPrimary}"
                                MinWidth="110" Margin="10,0,0,0" IsEnabled="False" Click="OnApply"/>
                        <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BtnGhost}"
                                Margin="10,0,0,0" Visibility="Collapsed" Click="OnCancel"/>
                    </WrapPanel>

                    <ProgressBar x:Name="SyncBar" Height="6" Minimum="0" Maximum="100" Margin="0,14,0,0"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="SyncResult" Style="{StaticResource PageHint}" Foreground="{StaticResource TextPrimary}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Border>

            <!-- ======== 种子导入卡片 ======== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="种子包导入" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,6" TextWrapping="Wrap"
                               Text="从群文件下载整合包（.mrpack），一键安装并同步到最新 manifest。FULL 包自带全部文件；LITE 包会自动补下缺件。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SeedPathBox" Style="{StaticResource InputBorder}" IsReadOnly="True"/>
                        <Button x:Name="BtnSeedBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" Click="OnSeedBrowse"/>
                        <Button x:Name="BtnSeedImport" Grid.Column="2" Content="导入种子包" Style="{StaticResource BtnPrimary}"
                                Margin="10,0,0,0" IsEnabled="False" Click="OnSeedImport"/>
                    </Grid>
                    <ProgressBar x:Name="SeedBar" Height="6" Minimum="0" Maximum="100" Margin="0,14,0,0"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="SeedStatus" Style="{StaticResource PageHint}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
