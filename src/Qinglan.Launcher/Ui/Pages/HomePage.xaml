<UserControl x:Class="Qinglan.Launcher.Ui.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                <GradientStop Color="#D8E6F8" Offset="0"/>
                <GradientStop Color="#F4F8FE" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="Wallpaper" Stretch="UniformToFill" Visibility="Collapsed"/>
        <Border Background="#AAFFFFFF" CornerRadius="14" Margin="70,40" Padding="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="轻蓝 MTR 2.0" FontFamily="Microsoft YaHei UI" FontSize="30"
                           FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="PackInfo" Text="尚未连接实例 · 先到「轻蓝同步」导入整合包"
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontFamily="Microsoft YaHei UI"/>
                <Button x:Name="LaunchButton" Content="启动游戏"
                        Style="{StaticResource BtnPrimary}" FontSize="17" FontWeight="Bold"
                        Padding="64,14" Margin="0,34,0,0" Click="OnLaunch"
                        HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                <TextBlock x:Name="LaunchHint" Text="" FontSize="12" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                           FontFamily="Microsoft YaHei UI"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
