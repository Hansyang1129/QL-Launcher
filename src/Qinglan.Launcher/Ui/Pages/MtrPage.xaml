<UserControl x:Class="Qinglan.Launcher.Ui.Pages.MtrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MTR 轨交" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,0"
                           Text="车站与线路时刻表、实时到站与路径规划；数据来自轻蓝服务器的 MTR 地图 API。"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="MtrStatusText" Text="尚未加载" Style="{StaticResource PageHint}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           AutomationProperties.AutomationId="MtrStatusText"/>
                <Button x:Name="BtnMtrRefresh" Content="刷新" Style="{StaticResource BtnGhost}"
                        Click="OnRefresh" AutomationProperties.AutomationId="BtnMtrRefresh"/>
            </StackPanel>
        </Grid>

        <!-- 页签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
            <RadioButton x:Name="TabStation" GroupName="MtrTab" Content="车站时刻表"
                         Style="{StaticResource SegTab}" IsChecked="True" Checked="OnTabChanged"
                         AutomationProperties.AutomationId="TabMtrStation"/>
            <RadioButton x:Name="TabRoute" GroupName="MtrTab" Content="线路时刻表"
                         Style="{StaticResource SegTab}" Checked="OnTabChanged"
                         AutomationProperties.AutomationId="TabMtrRoute"/>
            <RadioButton x:Name="TabPlan" GroupName="MtrTab" Content="查询路径"
                         Style="{StaticResource SegTab}" Checked="OnTabChanged"
                         AutomationProperties.AutomationId="TabMtrPlan"/>
        </StackPanel>

        <!-- ======== 车站时刻表 ======== -->
        <Grid x:Name="StationPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="搜索车站名…"
                               Style="{StaticResource PageHint}" Margin="2,0,0,4"/>
                    <TextBox x:Name="StationSearchBox" DockPanel.Dock="Top"
                             Style="{StaticResource InputBorder}" Margin="0,0,0,8"
                             TextChanged="OnStationSearchChanged"
                             AutomationProperties.AutomationId="StationSearch"
                             ToolTip="支持中文名、英文名与站台名片段"/>
                    <ListBox x:Name="StationList" Style="{StaticResource FlatList}"
                             SelectionChanged="OnStationSelected"
                             AutomationProperties.AutomationId="StationList"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="12,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StationTitle" Text="请选择车站"
                                       Style="{StaticResource BaseText}" FontSize="16" FontWeight="Bold"
                                       Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="StationTitle"/>
                            <TextBlock x:Name="StationSubtitle" Text="先选择左侧车站，再切换按站台 / 按线路"
                                       Style="{StaticResource PageHint}" Margin="0,2,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="StationSubtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    x:Name="StationModePanel" Visibility="Collapsed">
                            <RadioButton x:Name="ModePlatform" GroupName="StationMode" Content="按站台"
                                         Style="{StaticResource SegTab}" IsChecked="True"
                                         Checked="OnStationModeChanged"
                                         AutomationProperties.AutomationId="ModePlatform"/>
                            <RadioButton x:Name="ModeRoute" GroupName="StationMode" Content="按线路"
                                         Style="{StaticResource SegTab}" Checked="OnStationModeChanged"
                                         AutomationProperties.AutomationId="ModeRoute"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StationDetail" Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="StationDetail">
                            <TextBlock Text="先选择左侧车站，再在上方切换按站台 / 按线路。"
                                       Style="{StaticResource PageHint}"
                                       AutomationProperties.AutomationId="StationEmptyHint"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======== 线路时刻表 ======== -->
        <Grid x:Name="RoutePanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="搜索线路名…"
                               Style="{StaticResource PageHint}" Margin="2,0,0,4"/>
                    <TextBox x:Name="RouteSearchBox" DockPanel.Dock="Top"
                             Style="{StaticResource InputBorder}" Margin="0,0,0,8"
                             TextChanged="OnRouteSearchChanged"
                             AutomationProperties.AutomationId="RouteSearch"
                             ToolTip="支持中文名、英文名与方向后缀片段"/>
                    <ListBox x:Name="RouteList" Style="{StaticResource FlatList}"
                             SelectionChanged="OnRouteSelected"
                             AutomationProperties.AutomationId="RouteList"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="12,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="RouteTitle" Text="请选择线路"
                                   Style="{StaticResource BaseText}" FontSize="16" FontWeight="Bold"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="RouteTitle"/>
                        <TextBlock x:Name="RouteSubtitle" Text="按站序逐站展示最近一班与停靠站台"
                                   Style="{StaticResource PageHint}" Margin="0,2,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="RouteSubtitle"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RouteDetail" Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="RouteDetail">
                            <TextBlock Text="请选择左侧线路。" Style="{StaticResource PageHint}"
                                       AutomationProperties.AutomationId="RouteEmptyHint"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======== 查询路径 ======== -->
        <Grid x:Name="PlanPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="出发站" Style="{StaticResource PageHint}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FromFilter" Style="{StaticResource InputBorder}"
                                 TextChanged="OnFromFilterChanged"
                                 AutomationProperties.AutomationId="FromFilter"
                                 ToolTip="输入中文名 / 英文名筛选"/>
                        <ComboBox x:Name="FromCombo" Style="{StaticResource ComboBoxFlat}"
                                  Margin="0,6,0,0" SelectionChanged="OnPlanSelectionChanged"
                                  AutomationProperties.AutomationId="FromCombo"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="交换" Style="{StaticResource BtnGhost}"
                            VerticalAlignment="Bottom" Margin="0,0,10,10" Click="OnSwap"
                            AutomationProperties.AutomationId="BtnSwap"/>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="到达站" Style="{StaticResource PageHint}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ToFilter" Style="{StaticResource InputBorder}"
                                 TextChanged="OnToFilterChanged"
                                 AutomationProperties.AutomationId="ToFilter"
                                 ToolTip="输入中文名 / 英文名筛选"/>
                        <ComboBox x:Name="ToCombo" Style="{StaticResource ComboBoxFlat}"
                                  Margin="0,6,0,0" SelectionChanged="OnPlanSelectionChanged"
                                  AutomationProperties.AutomationId="ToCombo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <CheckBox x:Name="WebQueryCheck" Content="启用 API 查询" IsChecked="True"
                                  Style="{StaticResource OptionCheck}" Margin="0,0,0,8"
                                  AutomationProperties.AutomationId="WebQueryCheck"/>
                        <Button x:Name="BtnPlan" Content="查询路径" Style="{StaticResource BtnPrimary}"
                                Padding="22,9" Click="OnPlanQuery"
                                AutomationProperties.AutomationId="BtnPlanQuery"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PlanResults" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="PlanResults">
                    <TextBlock Text="请先选择出发与到达车站。" Style="{StaticResource PageHint}"
                               AutomationProperties.AutomationId="PlanEmptyHint"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
