<UserControl x:Class="Qinglan.Launcher.Ui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="只保留够用的：游戏根目录、Java、微软登录（可选）与调试入口。"
                       Style="{StaticResource PageHint}" Margin="0,4,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="窗口大小" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="下次启动生效；选择后会立即调整当前窗口。超过屏幕工作区时会自动夹到屏幕内。"/>
                    <ComboBox x:Name="WindowSizeBox" Style="{StaticResource ComboBoxFlat}" Width="240"
                              SelectionChanged="OnWindowSizeChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="游戏根目录" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="游戏根目录（.minecraft）。启动器只管理其中的 Qinglan-2nd-RPU 实例（版本隔离感知，平铺布局兼容）。同步与启动都以它为准。"/>
                    <TextBlock x:Name="GameDirText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" Text="（未设置）"/>
                    <WrapPanel>
                        <Button x:Name="BtnPickDir" Content="选择根目录…" Style="{StaticResource BtnGhost}" Click="OnPickDir"/>
                        <Button x:Name="BtnOpenDir" Content="打开目录" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                Click="OnOpenDir"/>
                        <Button x:Name="BtnOpenLog" Content="打开日志文件夹" Style="{StaticResource BtnGhost}"
                                Margin="10,0,0,0" Click="OnOpenLog"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Java 运行环境" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="自动探测会扫描 JAVA_HOME、Program Files 下的常见 JDK/JRE、PATH 与启动器下载的运行时。也可以手工指定包含 bin\java.exe 的目录。"/>
                    <TextBlock x:Name="JavaDirText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" Text="自动探测"/>
                    <TextBlock x:Name="JavaStatusText" Style="{StaticResource PageHint}" Margin="0,0,0,10" Text=""/>
                    <WrapPanel>
                        <Button x:Name="BtnPickJava" Content="选择 Java 目录…" Style="{StaticResource BtnGhost}"
                                Click="OnPickJava"/>
                        <Button x:Name="BtnAutoJava" Content="恢复自动探测" Style="{StaticResource BtnGhost}"
                                Margin="10,0,0,0" Click="OnAutoJava"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Java 启动参数" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,10" TextWrapping="Wrap"
                               Text="内存与额外 JVM 参数只保存在本机。留空表示自动/不追加；非法输入会在下方提示，不会保存。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="内存上限" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Microsoft YaHei UI"/>
                        <TextBox x:Name="MemoryInputBox" Grid.Column="1" Style="{StaticResource InputBorder}"
                                 Margin="10,0" VerticalContentAlignment="Center"
                                 TextChanged="OnJvmInputChanged"/>
                        <TextBlock Grid.Column="2" Text="MB；留空 = 自动（按可用内存与模组数估算）"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Microsoft YaHei UI" TextWrapping="Wrap"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="自动" Tag="0" Style="{StaticResource BtnGhost}"
                                Click="OnMemoryPreset"/>
                        <Button Content="4096 MB" Tag="4096" Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0" Click="OnMemoryPreset"/>
                        <Button Content="6144 MB" Tag="6144" Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0" Click="OnMemoryPreset"/>
                        <Button Content="8192 MB" Tag="8192" Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0" Click="OnMemoryPreset"/>
                        <Button Content="12288 MB" Tag="12288" Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0" Click="OnMemoryPreset"/>
                        <Button Content="16384 MB" Tag="16384" Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0" Click="OnMemoryPreset"/>
                    </WrapPanel>

                    <CheckBox x:Name="OptimizeMemoryCheck"
                              Content="启动游戏前进行内存优化（可能延长启动时间）"
                              Margin="0,10,0,0" Checked="OnOptimizeMemoryChanged"
                              Unchecked="OnOptimizeMemoryChanged"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="整理可访问进程的工作集；部分系统进程需要管理员权限，失败会跳过。"/>

                    <TextBlock Text="额外 JVM 参数" Margin="0,12,0,4" FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Microsoft YaHei UI"/>
                    <TextBox x:Name="JvmArgsBox" Style="{StaticResource InputBorder}" Height="86"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             VerticalScrollBarVisibility="Auto" TextChanged="OnJvmInputChanged"/>
                    <CheckBox x:Name="JvmPrettyCheck" Content="每个参数一行（见空格换行）"
                              Margin="0,6,0,0" Checked="OnJvmPrettyChanged"
                              Unchecked="OnJvmPrettyChanged"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="BtnMojangJvm" Content="Mojang 默认" Style="{StaticResource BtnGhost}"
                                Click="OnFillMojangJvm"/>
                        <CheckBox x:Name="UseVersionJvmCheck" Content="同时使用版本 JSON 自带 JVM 参数"
                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                  Checked="OnJvmVersionChanged" Unchecked="OnJvmVersionChanged"/>
                    </WrapPanel>
                    <TextBlock x:Name="JvmStatusText" Style="{StaticResource PageHint}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="BtnSaveJvm" Content="保存启动参数" Style="{StaticResource BtnGhost}"
                            Margin="0,8,0,0" Click="OnSaveJvm"/>

                    <TextBlock Text="最终 JVM 参数预览（不含游戏参数）" Style="{StaticResource PageHint}"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="JvmPreviewBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             MinHeight="86" MaxHeight="180" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#F7FAFF"
                             BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                             Padding="8" AcceptsReturn="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="微软登录（可选）" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="填写 Azure 应用的 client id 后，首页会出现「登录微软账号」（设备码流程）。留空则只用离线账号；离线模式不适用于正版验证服务器。"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClientIdBox" Style="{StaticResource InputBorder}"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnSaveClientId" Grid.Column="1" Content="保存" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" Click="OnSaveClientId"/>
                    </Grid>
                    <TextBlock x:Name="ClientIdStatusText" Style="{StaticResource PageHint}" Margin="0,8,0,0" Text=""/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" FontWeight="Bold" FontSize="14" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Style="{StaticResource PageHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="轻蓝启动器 1.0.0 —— 为「轻蓝 MTR 4.x」社区定制的轻量启动器。&#x0a;同步方式：包驱动（.mrpack 即更新源，单一 mods 频道 + 可选组），与 QL-HMCL 新版引擎互通。&#x0a;启动链：整合包版本 JSON + Mojang 规则裁剪 + 缺才下 + Mojang 运行时自动下载；支持离线与微软设备码登录。&#x0a;MTR 轨交页、论坛页在 v1.1。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
