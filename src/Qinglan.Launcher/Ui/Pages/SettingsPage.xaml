<UserControl x:Class="Qinglan.Launcher.Ui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="只保留够用的：游戏目录、内存、Java、调试（M2 接线）。"
                           Style="{StaticResource PageHint}" Margin="0,4,0,16"/>
                <Border Background="White" BorderBrush="#4F97F0" BorderThickness="1" CornerRadius="10"
                        Padding="16,10">
                    <TextBlock Text="M2 建设中：顺带会接「打开日志文件夹」。"
                               FontSize="13" Foreground="#33608A" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
