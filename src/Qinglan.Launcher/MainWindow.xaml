<Window x:Class="Qinglan.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻蓝启动器" Height="680" Width="1040" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Icon="Assets/branding/app.ico"
        Background="{StaticResource WindowBg}" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="18,0,0,0">
            <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                    Background="White" ClipToBounds="True">
                <Image Source="Assets/branding/logo.png" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="轻蓝启动器" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="10,0,8,0"
                       VerticalAlignment="Center"/>
            <Border Background="#E7F0FE" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="MTR 2.0" FontSize="10" Foreground="{StaticResource AccentDeep}"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WinCtrl}" Content="&#xE921;" Click="OnMinimize"/>
            <Button Style="{StaticResource WinCtrl}" Content="&#xE8BB;" Click="OnClose"
                    BorderThickness="0"/>
        </StackPanel>

        <!-- 侧栏 -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,1,0">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI"/>
                </DockPanel>
                <StackPanel x:Name="NavPanel" Margin="0,10,0,0">
                    <RadioButton GroupName="Nav" Content="首页" Tag="&#xE80F;"
                                 Style="{StaticResource NavItem}" IsChecked="True" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavHome"/>
                    <RadioButton GroupName="Nav" Content="轻蓝同步" Tag="&#xE72C;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavSync"/>
                    <RadioButton GroupName="Nav" Content="服务器状态" Tag="&#xE9D9;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavStatus"/>
                    <RadioButton GroupName="Nav" Content="MTR 地图" Tag="&#xE707;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavMap"/>
                    <RadioButton GroupName="Nav" Content="MTR 轨交" Tag="&#xE7C0;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavMtr"/>
                    <RadioButton GroupName="Nav" Content="论坛" Tag="&#xE90A;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavForum"/>
                    <RadioButton GroupName="Nav" Content="设置" Tag="&#xE713;"
                                 Style="{StaticResource NavItem}" Checked="OnNav"
                                 AutomationProperties.AutomationId="NavSettings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource WindowBg}">
            <ContentControl x:Name="Host" Margin="22,20,22,18"/>
        </Border>
    </Grid>
</Window>
