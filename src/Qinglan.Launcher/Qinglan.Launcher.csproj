<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Qinglan.Launcher</RootNamespace>
    <AssemblyName>QinglanLauncher</AssemblyName>
    <Version>1.0.0</Version>
    <Product>轻蓝启动器</Product>
    <AssemblyTitle>轻蓝启动器</AssemblyTitle>
    <Company>轻蓝 MTR 4.x 社区</Company>
    <Copyright>轻蓝 MTR 4.x 社区</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\branding\app.ico</ApplicationIcon>
    <!-- 本仓库不含外部 NuGet 包；出现 PackageReference 属于事故 -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 壁纸等素材随输出走（磁盘读取：加图零重建）；图标作为 WPF 资源打包 -->
    <Content Include="Assets\**\*" Exclude="Assets\branding\**" CopyToOutputDirectory="PreserveNewest"/>
    <Resource Include="Assets\branding\app.ico"/>
    <Resource Include="Assets\branding\logo.png"/>
  </ItemGroup>

  <ItemGroup>
    <!-- WebView2：直接引用随仓库分发的 SDK DLL（不是 NuGet 包）；Loader 必须落到 exe 同目录。 -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\..\lib\webview2\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>..\..\lib\webview2\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="..\..\lib\webview2\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
